# GitHub OAuth App credentials (server-side only)
GITHUB_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET
GITHUB_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/callback

# HMAC signing key for the HttpOnly application session (32 UTF-8 bytes minimum)
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Vercel KV credentials are configured in the deployment environment.

# Scheduled email reminders
CRON_SECRET=REPLACE_WITH_RANDOM_CRON_SECRET
GMAIL_USER=REPLACE_WITH_SENDER_EMAIL
GMAIL_APP_PASSWORD=REPLACE_WITH_EMAIL_APP_PASSWORD
